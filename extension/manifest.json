{
  "manifest_version": 3,
  "name": "Copilot browser interaction",
  "version": "0.2.0",
  "description": "Lets VS Code Copilot browse and test approved tabs in your real Chrome or Edge profile.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Copilot browser interaction",
    "default_popup": "popup.html"
  }
}
